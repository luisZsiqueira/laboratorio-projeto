# =====================================================================
# Python: bytecode, extensões compiladas e artefatos de build
# =====================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
wheels/
*.egg-info/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# =====================================================================
# Python: ambientes virtuais
# =====================================================================
.venv/
venv/
env/
ENV/

# =====================================================================
# Python: testes, cobertura, checagem de tipos e linters
# (pytest, coverage, mypy, ruff, tox/nox)
# =====================================================================
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.cache/

# =====================================================================
# Configuração local e credenciais (pydantic-settings lê o .env)
# O .env.example, sem valores sensíveis, pode ser versionado.
# =====================================================================
.env
.env.*
!.env.example

# =====================================================================
# Banco de dados SQLite3 (inclui arquivos de journal e WAL)
# =====================================================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

